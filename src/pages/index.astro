---
import Base from '../layouts/Base.astro';

const title = '일러스트레이터 패프 | 브랜드 일러스트 협업·단체 그림 원데이클래스';
const description = '일상의 색을 발견하고 가꾸는 일러스트레이터 패프(패터슨 프로젝트). 시즌 굿즈·패키지 일러스트 의뢰와 회사·기관으로 찾아가는 단체 그림 원데이클래스 문의를 받아요.';
const ogDescription = '일상의 색을 발견하고 가꾸는 사람. 시즌 굿즈·패키지 일러스트와 회사·기관 단체 그림 원데이클래스.';

// 클래스 FAQ: 화면과 JSON-LD(FAQPage)가 이 목록 하나를 같이 쓴다
const faqs = [
  { q: '그림을 한 번도 안 그려 봤어도 괜찮나요?', a: '한 장을 한 번에 그리지 않고 작은 조각으로 나눠 하나씩 완성해요. 어려운 관찰법 대신 \'내 컵은 어떻게 생겼지?\' 같은 질문부터 시작해요.' },
  { q: '재료는 무엇을 쓰나요?', a: '태블릿 없이 종이 재료로 준비해요. 구체적인 재료는 수업 구성에 맞춰 논의해서 정해요.' },
  { q: '누가 진행하나요?', a: '일러스트레이터 패프가 직접 진행해요.' },
  { q: '몇 명까지, 얼마나 걸리나요?', a: '행사 규모와 일정에 따라 달라요. 예상 인원과 원하시는 시간을 알려 주시면 그에 맞춰 논의해서 정해요.' },
  { q: '비용은 어떻게 되나요?', a: '인원, 시간, 재료에 따라 달라져요. 문의 내용을 보고 함께 논의해서 정해요.' },
  { q: '기관 제출 서류도 준비되나요?', a: '기관마다 필요한 서류가 달라요. 문의하실 때 필요한 서류를 알려 주시면 함께 확인하고 논의해서 정해요.' },
];

const site = Astro.site!.href;
const person = { '@id': `${site}#person` };
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: '패터슨 프로젝트',
      alternateName: ['Paterson Project', 'PA.P'],
      inLanguage: 'ko-KR',
      publisher: person,
    },
    {
      '@type': 'Person',
      '@id': `${site}#person`,
      name: '패프',
      alternateName: ['PA.P', 'Paterson Project'],
      jobTitle: '일러스트레이터',
      description: '일상의 색을 발견하고 가꾸는 일러스트레이터. 컬러 팔레트 기획, 패키지 일러스트 디자인, 브랜드 협업.',
      url: site,
      email: 'mailto:paterson_project@naver.com',
      sameAs: ['https://www.instagram.com/paterson.project/', 'https://blog.naver.com/paterson_project'],
    },
    {
      '@type': 'Service',
      name: '브랜드 일러스트 협업',
      serviceType: '일러스트레이션',
      description: '계절 한정 굿즈, 패키지, 시즌 캘린더에 들어갈 일러스트 의뢰',
      provider: person,
      areaServed: 'KR',
    },
    {
      '@type': 'Service',
      name: '단체 그림 원데이클래스',
      serviceType: '원데이클래스',
      description: '회사와 기관의 회의실·강의실로 찾아가는 종이 그림 원데이클래스. 인원·시간·비용은 문의 후 논의해서 정해요.',
      provider: person,
      areaServed: 'KR',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Base title={title} description={description} ogDescription={ogDescription}>
<script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

<nav class="nav" aria-label="주 메뉴">
  <div class="wrap">
    <a class="mark" href="#top"><b>PA.P</b><span>paterson project</span></a>
    <ul class="menu">
      <li><a href="#portfolio">포트폴리오</a></li>
      <li><a href="#class">단체 클래스</a></li>
      <li><a href="#blog">블로그</a></li>
      <li><a class="btn btn-main" href="#contact">문의하기</a></li>
    </ul>
  </div>
</nav>

<!-- 첫 화면: 패프 포트폴리오 표지처럼 -->
<header class="hero" id="top">
  <div class="wrap">
    <div class="collage" aria-label="패프의 작품 콜라주">
      <figure class="pola c1"><span class="tape top"></span><img src="img/w-picnic.jpg" alt="잔디밭에서 강아지와 소풍하는 여성 일러스트"><figcaption>Picinic With (2026)</figcaption></figure>
      <figure class="pola c2"><span class="tape corner t-green"></span><img src="img/w-hongkong.jpg" alt="빨간 2층 트램이 지나가는 홍콩 거리 일러스트"></figure>
      <figure class="pola c3"><span class="tape top t-yellow" style="--w:80px"></span><img src="img/season-spring.jpg" alt="튤립 꽃밭과 나무 아래 토끼 두 마리"></figure>
      <figure class="pola c4"><span class="tape corner-r t-blue"></span><img src="img/w-wintercoming.jpg" alt="눈 내리는 밤 파리 건물 일러스트"></figure>
      <figure class="pola c5"><span class="tape top" style="--w:74px;--tr:6deg"></span><img src="img/w-matcha.jpg" alt="말차 메뉴 조각 그림 모음"></figure>
      <div class="scrap c6" style="--r:6deg">
        <p style="font-family:'League Spartan',sans-serif;font-weight:700;font-size:15px;color:var(--forest)">paterson palette</p>
        <div class="dots"><i style="--c:#74b16b"></i><i style="--c:#bac972"></i><i style="--c:#b4895a"></i><i style="--c:#d0d0b1"></i><i style="--c:#ee97a3"></i></div>
      </div>
    </div>

    <div class="cover-title">
      <h2 class="display" style="--fill:var(--sage);--shade:var(--pink)">PA.P Illustration Portfolio</h2>
      <p class="sub">일러스트레이터 패프 포트폴리오</p>
    </div>

    <div class="hero-copy">
      <div>
        <p class="title">일러스트레이터 &amp; 컬러 가드너 패프</p>
        <h1>일상의 색을 발견하고<br>가꾸는 사람</h1>
        <div class="what"><span>컬러 팔레트 기획</span><span>패키지 일러스트 디자인</span><span>브랜드 협업</span></div>
      </div>
      <div>
        <p class="lead">계절 한정 굿즈, 패키지, 시즌 캘린더에 들어갈 그림 의뢰를 받아요. 회사와 기관으로 찾아가는 단체 그림 클래스도 진행하고 있어요.</p>
        <div class="btns">
          <a class="btn btn-main" href="mailto:paterson_project@naver.com?subject=%5B%EC%9E%91%EC%97%85%C2%B7%ED%98%91%EC%97%85%20%EB%AC%B8%EC%9D%98%5D">작업·협업 문의하기</a>
          <a class="btn btn-line" href="#class">단체 그림 클래스 보기</a>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- 두 입구 -->
<section style="padding-top:12px">
  <div class="wrap doors">
    <a class="door brand scrap" href="#portfolio" style="--r:-1deg">
      <h2>브랜드 협업</h2>
      <p>시즌 굿즈·패키지·캘린더 일러스트</p>
      <div class="dots" aria-hidden="true"><i style="--c:#2a4816"></i><i style="--c:#74964a"></i><i style="--c:#ebe5c7"></i><i style="--c:#e7b625"></i><i style="--c:#c52664"></i></div>
      <span class="go">포트폴리오 보기</span>
    </a>
    <a class="door class scrap" href="#class" style="--r:1deg">
      <h2>단체 그림 클래스</h2>
      <p>그림을 처음 그려 보는 분도 한 장을 끝까지 완성하는 종이 그림 원데이클래스예요.</p>
      <div class="dots" aria-hidden="true"><i style="--c:#162b4e"></i><i style="--c:#3083a8"></i><i style="--c:#accde5"></i><i style="--c:#f2f3f4"></i><i style="--c:#a41c19"></i></div>
      <span class="go">클래스 안내 보기</span>
    </a>
  </div>
</section>

<!-- 포트폴리오: 패프 포트폴리오의 묶음 방식 -->
<section id="portfolio" class="paper-stripe torn-top">
  <div class="wrap">
    <h2 class="display" style="--fill:var(--forest);--shade:var(--marigold)">Portfolio</h2>

    <div class="group">
      <div class="group-head"><h3 class="display sm" style="--fill:var(--forest);--shade:var(--red)">Color Palette ; Green &amp; Red</h3></div>
      <div class="group-row" style="--n:3">
        <figure class="pola"><span class="tape top t-green"></span><img src="img/w-jeep.jpg" alt="빨간 지프와 캠핑하는 커플, 강아지"><figcaption>Jeep, Camp, and Us (2025)<div class="dots"><i style="--c:#708c37"></i><i style="--c:#90b2ac"></i><i style="--c:#b4cfc8"></i><i style="--c:#ae0a11"></i><i style="--c:#edf4f3"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top"></span><img src="img/w-hongkong.jpg" alt="빨간 2층 트램이 지나가는 홍콩 거리"><figcaption>Hongkong (2026)<div class="dots"><i style="--c:#2c5315"></i><i style="--c:#49752a"></i><i style="--c:#716954"></i><i style="--c:#928975"></i><i style="--c:#b0a995"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top t-yellow"></span><img src="img/season-summer.jpg" alt="능소화 덩굴 아래 파라솔 테이블에 앉은 두 사람"><figcaption>능소화의 계절 (2025)<div class="dots"><i style="--c:#336c2a"></i><i style="--c:#759031"></i><i style="--c:#b1af8f"></i><i style="--c:#d4c9b2"></i><i style="--c:#f4f8f7"></i></div></figcaption></figure>
      </div>
    </div>

    <div class="group">
      <div class="group-head"><h3 class="display sm" style="--fill:var(--navy);--shade:#b4895a">Color Palette ; Blue &amp; Brown</h3></div>
      <div class="group-row" style="--n:3">
        <figure class="pola"><span class="tape top t-blue"></span><img src="img/w-seollal.jpg" alt="눈 덮인 한옥 앞 한복 차림 두 사람과 고양이"><figcaption>눈오는 설날 (2026)<div class="dots"><i style="--c:#772d10"></i><i style="--c:#908f8f"></i><i style="--c:#b4b4b2"></i><i style="--c:#d0d1d1"></i><i style="--c:#f5f7f8"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top"></span><img src="img/season-winter.jpg" alt="눈 덮인 자작나무 숲의 새끼 사슴"><figcaption>자작나무 숲 속에 사슴 한 마리 (2025)<div class="dots"><i style="--c:#1a5773"></i><i style="--c:#3083a8"></i><i style="--c:#afb0b0"></i><i style="--c:#d1d3d2"></i><i style="--c:#f2f3f4"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top t-yellow"></span><img src="img/w-ramen.jpg" alt="발코니에서 컵라면 먹는 커플"><figcaption>La Vie Ramen (2025)<div class="dots"><i style="--c:#323130"></i><i style="--c:#8b9193"></i><i style="--c:#aeb2b3"></i><i style="--c:#f0d3af"></i><i style="--c:#eff6f9"></i></div></figcaption></figure>
      </div>
    </div>

    <div class="group">
      <div class="group-head"><h3 class="display sm" style="--fill:#94b148;--shade:var(--pink)">Simple &amp; Round</h3><p>두터운 질감의 브러시로 담아낸 단순한 형태의 일상들</p></div>
      <div class="group-row" style="--n:4">
        <figure class="pola"><span class="tape top t-yellow" style="--w:76px"></span><img src="img/season-spring.jpg" alt="튤립 꽃밭과 토끼 두 마리"><figcaption>Tulip Ripple (2026)<div class="dots"><i style="--c:#547231"></i><i style="--c:#91ac55"></i><i style="--c:#bcc94c"></i><i style="--c:#f4ce90"></i><i style="--c:#d2ebed"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top" style="--w:76px"></span><img src="img/w-picnic.jpg" alt="강아지와 소풍하는 여성"><figcaption>Picinic With (2026)<div class="dots"><i style="--c:#74b16b"></i><i style="--c:#bac972"></i><i style="--c:#b4895a"></i><i style="--c:#d0d0b1"></i><i style="--c:#f0ead3"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top t-green" style="--w:76px"></span><img src="img/w-flowershop.jpg" alt="꽃집 앞에서 물 주는 할아버지"><figcaption>패터슨 할아버지의 꽃집 (2026)<div class="dots"><i style="--c:#6ab06e"></i><i style="--c:#faa871"></i><i style="--c:#ca796b"></i><i style="--c:#cdd2d4"></i><i style="--c:#edf4f2"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top t-blue" style="--w:76px"></span><img src="img/w-tennis.jpg" alt="숲속 테니스 코트에서 테니스 치는 사람들"><figcaption>Tennis court (2026)<div class="dots"><i style="--c:#3b6b3a"></i><i style="--c:#518d53"></i><i style="--c:#70ac6f"></i><i style="--c:#94b994"></i><i style="--c:#f4fcf8"></i></div></figcaption></figure>
      </div>
      <p class="note-txt">Digital Illustration (Gouache, Oil paint Brush), Procreate.</p>
    </div>

    <div class="group">
      <div class="group-head"><h3 class="display sm" style="--fill:var(--sky);--shade:#d9b48a">Oil Pastel Texture</h3><p>폭닥하고 부드러운 오일파스텔의 따뜻한 질감</p></div>
      <div class="group-row" style="--n:3">
        <figure class="pola"><span class="tape top t-blue"></span><img src="img/w-beach.jpg" alt="바닷가에서 모래놀이하는 아이들"><figcaption>Beach Explorer (2026)<div class="dots"><i style="--c:#3092d3"></i><i style="--c:#8dcbfc"></i><i style="--c:#d9b48a"></i><i style="--c:#f4d1a9"></i><i style="--c:#f0f6fa"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top t-yellow"></span><img src="img/w-florist.jpg" alt="꽃집 안의 플로리스트와 손님"><figcaption>The Florist's Studio (2025)<div class="dots"><i style="--c:#486e38"></i><i style="--c:#8b572d"></i><i style="--c:#a7754c"></i><i style="--c:#d6b189"></i><i style="--c:#f3edd9"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top"></span><img src="img/w-sprouting.jpg" alt="온실과 분수, 꽃밭이 있는 수목원 풍경"><figcaption>Memories, Sprouting (2026)<div class="dots"><i style="--c:#94b148"></i><i style="--c:#d58c6c"></i><i style="--c:#f6d0b7"></i><i style="--c:#cce5d9"></i><i style="--c:#f1f6f7"></i></div></figcaption></figure>
      </div>
      <p class="note-txt">Digital Illustration (Oil pastel Brush), Procreate.</p>
    </div>

    <div class="group">
      <div class="group-head"><h3 class="display sm" style="--fill:var(--navy);--shade:var(--red)">Winter Mood</h3></div>
      <div class="group-row" style="--n:3">
        <figure class="pola"><span class="tape top t-blue"></span><img src="img/w-wintercoming.jpg" alt="눈 내리는 밤 파리 건물과 창 속 사람들"><figcaption>Winter Is Coming (2025)<div class="dots"><i style="--c:#162b4e"></i><i style="--c:#34466f"></i><i style="--c:#ab8f73"></i><i style="--c:#d0b493"></i><i style="--c:#e6d8c8"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top"></span><img src="img/w-frosty.jpg" alt="눈사람과 아이들"><figcaption>Four Kids and a Frosty Friend (2025)<div class="dots"><i style="--c:#0e340e"></i><i style="--c:#546b4c"></i><i style="--c:#74896e"></i><i style="--c:#accde5"></i><i style="--c:#eff0f1"></i></div></figcaption></figure>
        <figure class="pola"><span class="tape top t-yellow"></span><img src="img/w-attic.jpg" alt="다락방의 커플과 잠든 강아지"><figcaption>Cozy Winter Attic (2025)<div class="dots"><i style="--c:#162b4e"></i><i style="--c:#a41c19"></i><i style="--c:#907664"></i><i style="--c:#c6b2a5"></i><i style="--c:#e6d9d1"></i></div></figcaption></figure>
      </div>
    </div>

    <div class="group">
      <div class="group-head"><h3 class="display sm" style="--fill:#94b171;--shade:var(--pink)">Spot Illustration</h3></div>
      <div class="group-row" style="--n:3">
        <figure class="pola" style="grid-column:1 / -1;max-width:760px;justify-self:center"><span class="tape top t-green"></span><img src="img/w-matcha.jpg" alt="말차 메뉴 12종 조각 그림" style="--ar:16/10"><figcaption>Matcha Girlie (2026)<div class="dots"><i style="--c:#719052"></i><i style="--c:#94b171"></i><i style="--c:#b0c592"></i><i style="--c:#eab5ca"></i><i style="--c:#f9f7f4"></i></div></figcaption></figure>
      </div>
    </div>
  </div>
</section>

<!-- 콘셉트 작업 -->
<section>
  <div class="wrap">
    <h2 class="display" style="--fill:var(--pink);--shade:var(--berry)">Concept Work</h2>

    <div class="case">
      <div class="case-img">
        <img src="img/cw-tea.png" alt="잔꽃 패턴을 입힌 차 상자와 봉투 목업">
        <div class="case-sub">
          <img src="img/cw-tea-pattern.jpg" alt="초록 붓터치 위 흰색과 분홍 잔꽃 패턴 원화">
          <figure><img src="img/work-lilac.jpg" alt="라일락 사이 향수 상자와 병 목업"><figcaption class="cap"><b>Lilac Breeze</b> (Concept Work)</figcaption></figure>
        </div>
      </div>
      <div>
        <div class="pbar" aria-hidden="true"><i style="--c:#2a4816;--w:12"></i><i style="--c:#4c7932;--w:6"></i><i style="--c:#74964a;--w:2"></i><i style="--c:#ebe5c7;--w:4"></i><i style="--c:#e7b625;--w:1.5"></i><i style="--c:#c52664;--w:1.5"></i></div>
        <p class="meta">Project Title <span>Wildflowers</span><br>Client <span>Blooming Brew (Concept Work)</span><br>Role <span>Illustration &amp; Package Design</span></p>
        <h3>들꽃의 향기와 생명력이 피어오르는 순간을 담았습니다.</h3>
